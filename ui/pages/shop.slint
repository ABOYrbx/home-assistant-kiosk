import { Theme } from "../theme.slint";
import { TouchTarget } from "../widgets/touch_target.slint";

export struct ShopEntryView {
    id: string,
    name: string,
    version: string,
    author: string,
    license: string,
    description: string,
    status: string,
    permissions: string,
    config-keys: string,
    config-status: string,
    config-path: string,
    secret-path: string,
    error: string,
    installed: bool,
    enabled: bool,
    update-available: bool,
    available: bool,
}

component ShopButton inherits TouchTarget {
    in property <string> label: "";
    in property <string> action-label: "";
    in property <bool> primary: false;
    in property <bool> destructive: false;

    border-radius: Theme.radius-md;
    background: primary ? Theme.accent : Theme.surface;
    border-width: 1px;
    border-color: destructive ? Theme.danger : Theme.border;
    opacity: root.enabled ? 1.0 : 0.45;

    accessible-role: button;
    accessible-label: root.action-label != "" ? root.action-label : root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    Text {
        text: root.label;
        color: primary ? Theme.accent-on : (destructive ? Theme.danger : Theme.fg);
        font-size: Theme.text-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    focus-scope := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if root.enabled && (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    forward-focus: focus-scope;

    focus-ring := Rectangle {
        visible: focus-scope.has-focus;
        border-width: Theme.focus-ring-width;
        border-color: Theme.focus-ring;
        border-radius: root.border-radius;
    }

    states [
        pressed when root.pressed: {
            background: Theme.border;
        }
    ]
}

component ShopEntryCard inherits Rectangle {
    in property <ShopEntryView> entry;
    in property <bool> actions-enabled: true;
    callback install(string);
    callback update(string);
    callback remove(string);
    callback set-enabled(string, bool);

    background: Theme.surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;

    accessible-role: list-item;
    accessible-label: entry.name + ", " + entry.status;

    card-content := VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2;

        HorizontalLayout {
            spacing: Theme.space-2;
            Text {
                text: entry.name;
                accessible-label: entry.name;
                color: Theme.fg;
                font-size: Theme.text-base;
                font-weight: 600;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: "v" + entry.version;
                accessible-label: "Version " + entry.version;
                color: Theme.muted;
                font-size: Theme.text-sm;
                overflow: elide;
            }
            Text {
                text: entry.status;
                accessible-label: entry.status;
                color: entry.status == "Error" ? Theme.danger : (entry.status == "Disabled" ? Theme.warn : Theme.muted);
                font-size: Theme.text-sm;
                horizontal-alignment: right;
                overflow: elide;
            }
        }

        Text {
            text: (entry.author != "" ? "by " + entry.author : "Unknown author")
                + " · " + (entry.license != "" ? entry.license : "License not declared");
            color: Theme.fg-2;
            font-size: Theme.text-sm;
            overflow: elide;
        }

        Text {
            text: entry.description != "" ? entry.description : "No description provided.";
            accessible-label: entry.description != "" ? entry.description : "No description provided.";
            color: Theme.fg-2;
            font-size: Theme.text-sm;
            wrap: word-wrap;
            max-lines: 3;
            overflow: elide;
        }

        Text {
            text: "Permissions: " + entry.permissions;
            accessible-label: "Permissions: " + entry.permissions;
            color: Theme.muted;
            font-size: Theme.text-xs;
            wrap: word-wrap;
        }

        Text {
            text: "Configuration: " + entry.config-status;
            accessible-label: entry.config-status;
            color: entry.config-status == "Configuration required" ? Theme.warn : Theme.muted;
            font-size: Theme.text-xs;
            wrap: word-wrap;
        }

        Text {
            text: "Keys: " + entry.config-keys;
            accessible-label: "Configuration: " + entry.config-keys;
            color: Theme.muted;
            font-size: Theme.text-xs;
            wrap: word-wrap;
        }

        Text {
            text: entry.config-path;
            accessible-label: entry.config-path;
            color: Theme.muted;
            font-size: Theme.text-xs;
            overflow: elide;
        }

        Text {
            text: entry.secret-path;
            accessible-label: entry.secret-path;
            color: Theme.muted;
            font-size: Theme.text-xs;
            overflow: elide;
        }

        if entry.error != "" : Text {
            text: entry.error;
            accessible-label: entry.error;
            color: Theme.danger;
            font-size: Theme.text-xs;
            wrap: word-wrap;
        }

        entry-actions := HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;

            if entry.update-available : update-button := ShopButton {
                label: "Update";
                action-label: "Update " + entry.name;
                primary: true;
                enabled: root.actions-enabled;
                clicked => { root.update(entry.id); }
            }

            if entry.installed : toggle-button := ShopButton {
                label: entry.enabled ? "Disable" : "Enable";
                action-label: (entry.enabled ? "Disable " : "Enable ") + entry.name;
                enabled: root.actions-enabled;
                clicked => { root.set-enabled(entry.id, !entry.enabled); }
            }

            if entry.installed : remove-button := ShopButton {
                label: "Remove";
                action-label: "Remove " + entry.name;
                destructive: true;
                enabled: root.actions-enabled;
                clicked => { root.remove(entry.id); }
            }

            if !entry.installed && entry.available : install-button := ShopButton {
                label: "Install";
                action-label: "Install " + entry.name;
                primary: true;
                enabled: root.actions-enabled;
                clicked => { root.install(entry.id); }
            }
        }
    }
}

export component ShopPage inherits Rectangle {
    background: Theme.bg;

    in property <[ShopEntryView]> installed: [];
    in property <[ShopEntryView]> available: [];
    in property <bool> catalog-online: false;
    in property <bool> loading: true;
    in property <string> catalog-error: "";
    in property <string> config-path: "";
    in property <string> secret-dir: "";
    in property <string> pending-id: "";
    in-out property <string> confirm-id: "";
    in-out property <string> confirm-name: "";
    in-out property <string> confirm-permissions: "";
    in property <string> confirm-warning: "Community extensions are third-party code. A signed catalog proves who published a package, not that it is safe. Only install extensions you trust, and review the permissions below.";

    callback refresh();
    callback update(string);
    callback remove(string);
    callback set-enabled(string, bool);
    callback confirm-install(string);

    page-content := VerticalLayout {
        x: (root.width - self.width) / 2;
        width: Math.min(root.width, Theme.content-max-width);
        height: 100%;
        padding: Theme.space-3;
        spacing: Theme.space-3;

        shop-header := HorizontalLayout {
            spacing: Theme.space-3;
            Text {
                text: "Extensions";
                accessible-label: "Extensions";
                color: Theme.fg;
                font-size: Theme.text-xl;
                font-weight: 600;
                vertical-alignment: center;
            }
            catalog-status := Text {
                text: loading ? "Catalog loading" : (catalog-online ? "Catalog online" : "Catalog offline");
                accessible-label: loading ? "Catalog loading" : (catalog-online ? "Catalog online" : "Catalog offline");
                color: loading ? Theme.muted : (catalog-online ? Theme.success : Theme.warn);
                font-size: Theme.text-sm;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
            refresh-button := ShopButton {
                label: "Refresh";
                action-label: "Refresh catalog";
                enabled: pending-id == "" && confirm-id == "";
                clicked => { root.refresh(); }
            }
        }

        if !loading && !catalog-online : Rectangle {
            background: Theme.surface-warm;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.space-2;
                spacing: Theme.space-1;
                Text {
                    text: "The catalog is offline. Installed extensions keep working; install and update are unavailable.";
                    accessible-label: "The catalog is offline. Installed extensions keep working; install and update are unavailable.";
                    color: Theme.warn;
                    font-size: Theme.text-sm;
                    wrap: word-wrap;
                }
                if catalog-error != "" : Text {
                    text: catalog-error;
                    accessible-label: catalog-error;
                    color: Theme.muted;
                    font-size: Theme.text-xs;
                    wrap: word-wrap;
                }
            }
        }

        if pending-id != "" : Text {
            text: "Working on " + pending-id + "…";
            accessible-label: "Working on " + pending-id + "…";
            color: Theme.muted;
            font-size: Theme.text-sm;
        }

        shop-scroll := Flickable {
            vertical-stretch: 1;
            interactive: true;
            mouse-drag-pan-enabled: true;
            content-width: self.width;
            content-height: shop-content.preferred-height;

            shop-content := VerticalLayout {
                width: shop-scroll.width;
                spacing: Theme.space-3;

                if loading : Text {
                    text: "Loading extensions…";
                    accessible-label: "Loading extensions…";
                    color: Theme.muted;
                    font-size: Theme.text-sm;
                }

                Text {
                    text: "Installed";
                    accessible-label: "Installed";
                    color: Theme.fg;
                    font-size: Theme.text-lg;
                    font-weight: 600;
                }

                if !loading && installed.length == 0 : Text {
                    text: "No extensions installed. Choose one from the available list.";
                    accessible-label: "No extensions installed. Choose one from the available list.";
                    color: Theme.muted;
                    font-size: Theme.text-sm;
                    wrap: word-wrap;
                }

                installed-list := VerticalLayout {
                    spacing: Theme.space-3;
                    for item in installed : ShopEntryCard {
                        entry: item;
                        actions-enabled: pending-id == "" && confirm-id == "";
                        install(id) => {
                            root.confirm-id = id;
                            root.confirm-name = item.name;
                            root.confirm-permissions = item.permissions;
                        }
                        update(id) => { root.update(id); }
                        remove(id) => { root.remove(id); }
                        set-enabled(id, on) => { root.set-enabled(id, on); }
                    }
                }

                Text {
                    text: "Available";
                    accessible-label: "Available";
                    color: Theme.fg;
                    font-size: Theme.text-lg;
                    font-weight: 600;
                }

                if !loading && available.length == 0 : Text {
                    text: catalog-online ? "No extensions are available in the catalog." : "Install and update are unavailable while the catalog is offline.";
                    accessible-label: catalog-online ? "No extensions are available in the catalog." : "Install and update are unavailable while the catalog is offline.";
                    color: Theme.muted;
                    font-size: Theme.text-sm;
                    wrap: word-wrap;
                }

                available-list := VerticalLayout {
                    spacing: Theme.space-3;
                    for item in available : ShopEntryCard {
                        entry: item;
                        actions-enabled: pending-id == "" && confirm-id == "";
                        install(id) => {
                            root.confirm-id = id;
                            root.confirm-name = item.name;
                            root.confirm-permissions = item.permissions;
                        }
                        update(id) => { root.update(id); }
                        remove(id) => { root.remove(id); }
                        set-enabled(id, on) => { root.set-enabled(id, on); }
                    }
                }

                if config-path != "" || secret-dir != "" : Text {
                    text: "Settings file: " + config-path + "   Secrets: " + secret-dir;
                    accessible-label: "Settings file: " + config-path + "   Secrets: " + secret-dir;
                    color: Theme.muted;
                    font-size: Theme.text-xs;
                    wrap: word-wrap;
                }
            }
        }
    }

    // First-install trust confirmation. Drawn last so it covers the list.
    if confirm-id != "" : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: Theme.bg;
        clip: true;

        confirmation-content := VerticalLayout {
            x: (root.width - self.width) / 2;
            width: Math.min(root.width, Theme.content-max-width);
            height: 100%;
            padding: Theme.space-4;
            spacing: Theme.space-3;

            Text {
                text: "Install " + confirm-name + "?";
                accessible-label: "Install " + confirm-name + "?";
                color: Theme.fg;
                font-size: Theme.text-xl;
                font-weight: 600;
                wrap: word-wrap;
            }

            confirmation-scroll := Flickable {
                vertical-stretch: 1;
                content-width: self.width;
                content-height: confirmation-copy.preferred-height;
                confirmation-copy := VerticalLayout {
                    width: confirmation-scroll.width;
                    spacing: Theme.space-3;
                    Text {
                        text: confirm-warning;
                        accessible-label: confirm-warning;
                        color: Theme.fg-2;
                        font-size: Theme.text-sm;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "Permissions: " + confirm-permissions;
                        accessible-label: "Permissions: " + confirm-permissions;
                        color: Theme.muted;
                        font-size: Theme.text-sm;
                        wrap: word-wrap;
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: end;

                cancel-button := ShopButton {
                    label: "Cancel";
                    action-label: "Cancel installation";
                    clicked => { root.confirm-id = ""; }
                }

                confirm-button := ShopButton {
                    label: "Install";
                    action-label: "Confirm install " + confirm-name;
                    primary: true;
                    clicked => {
                        let id = root.confirm-id;
                        root.confirm-id = "";
                        root.confirm-install(id);
                    }
                }
            }
        }
    }
}
