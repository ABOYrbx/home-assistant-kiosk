import { Theme } from "../theme.slint";
import { PageHeader } from "../components/page_header.slint";
import { WeatherIcon } from "../components/weather_icon.slint";

export component StatusPage inherits Rectangle {
    in property <[string]> conditions: [
        "sunny",
        "clear-night",
        "partlycloudy",
        "partlycloudy-night",
        "cloudy",
        "rainy",
        "pouring",
        "snowy",
        "fog",
        "lightning",
        "windy",
        "exceptional",
    ];

    background: Theme.bg;

    in property <[string]> extension-errors: [];

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-3;

        Text {
            text: "Status";
            color: Theme.fg;
            font-size: Theme.text-xl;
        }

        if extension-errors.length > 0 : Rectangle {
            background: Theme.surface-warm;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: Theme.space-3;
                spacing: Theme.space-1;
                Text {
                    text: "Extension errors";
                    color: Theme.fg;
                    font-size: Theme.text-base;
                    font-weight: 600;
                }
                for message in extension-errors : Text {
                    text: message;
                    color: Theme.danger;
                    font-size: Theme.text-sm;
                    wrap: word-wrap;
                }
            }
        }
    }
}
