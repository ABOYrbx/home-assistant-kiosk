import { Theme } from "../theme.slint";
import { AgendaEntry, CalendarWidget } from "../widgets/calendar.slint";

export component AgendaPage inherits Rectangle {
    in property <[AgendaEntry]> today: [];
    in property <[AgendaEntry]> tomorrow: [];
    in property <bool> loading: false;
    in property <bool> empty: false;
    in property <string> error: "";
    in property <string> status: "";
    out property <float> scroll-y: calendar.scroll-y;
    callback scrolled(float);

    property <float> tracked-scroll: calendar.scroll-y;
    changed tracked-scroll => { root.scrolled(tracked-scroll); }

    background: Theme.bg;
    clip: true;

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-3;

        calendar := CalendarWidget {
            vertical-stretch: 1;
            today: root.today;
            tomorrow: root.tomorrow;
            loading: root.loading;
            empty: root.empty;
            error: root.error;
            status: root.status;
        }
    }
}
