import { Theme } from "../theme.slint";

export component HaTile inherits Rectangle {
    in property <string> label: "";
    in property <string> icon: "";
    in property <string> state: "";
    in property <string> detail: "";
    in property <bool> read-only: false;
    in property <bool> pending: false;
    in property <string> error: "";
    callback tapped();

    min-width: Theme.touch-target;
    min-height: Theme.tile-min-height;
    background: Theme.surface;
    border-radius: Theme.radius-md;
    border-width: Theme.border-width;
    border-color: root.read-only ? Theme.border-soft : Theme.border;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: !root.read-only && !root.pending;
    accessible-action-default => {
        if !root.read-only && !root.pending {
            root.tapped();
        }
    }

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-1;

        if root.icon != "" : Text {
            text: root.icon;
            color: Theme.muted;
            font-size: Theme.text-xs;
        }
        Text {
            text: root.label;
            color: Theme.fg;
            font-size: Theme.text-sm;
            font-weight: Theme.weight-medium;
            overflow: elide;
        }
        Text {
            text: root.pending ? "…" : root.state;
            color: root.read-only ? Theme.muted : Theme.fg-2;
            font-size: Theme.text-sm;
            overflow: elide;
        }
        if root.detail != "" && !root.pending && root.error == "" : Text {
            text: root.detail;
            color: Theme.muted;
            font-size: Theme.text-xs;
            overflow: elide;
        }
        if root.error != "" : Text {
            text: root.error;
            color: Theme.danger;
            font-size: Theme.text-xs;
            overflow: elide;
        }
    }

    tile-touch := TouchArea {
        enabled: !root.read-only && !root.pending;
        clicked => { root.tapped(); }
    }

    states [
        pressed when tile-touch.pressed && !root.read-only && !root.pending: {
            background: Theme.border;
        }
    ]
}
