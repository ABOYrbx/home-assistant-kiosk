import { Theme } from "../theme.slint";

export component ToggleSwitch inherits Rectangle {
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled();

    width: Theme.switch-width;
    height: Theme.touch-target;
    opacity: enabled ? 1.0 : 0.45;
    accessible-role: switch;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.toggled();
        }
    }

    Rectangle {
        y: (root.height - Theme.switch-track-height) / 2;
        width: Theme.switch-width;
        height: Theme.switch-track-height;
        border-radius: Theme.radius-pill;
        background: root.checked ? Theme.accent : Theme.border;
    }

    Rectangle {
        x: root.checked
            ? Theme.switch-width - Theme.switch-inset - Theme.switch-knob-size
            : Theme.switch-inset;
        y: (root.height - Theme.switch-knob-size) / 2;
        width: Theme.switch-knob-size;
        height: Theme.switch-knob-size;
        border-radius: Theme.radius-pill;
        background: Theme.bg;
        border-width: Theme.border-width;
        border-color: Theme.border;
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => { root.toggled(); }
    }
}
