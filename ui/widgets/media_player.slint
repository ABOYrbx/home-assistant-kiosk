import { Theme } from "../theme.slint";

export component MediaPlayerWidget inherits Rectangle {
    in property <string> title: "";
    in property <string> artist: "";
    in property <string> state: "";
    in property <image> art;

    background: Theme.surface;
    border-radius: Theme.radius-md;
    border-width: Theme.border-width;
    border-color: Theme.border;

    HorizontalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-3;
        Image {
            source: art;
            width: Theme.album-art-size;
            height: Theme.album-art-size;
        }
        VerticalLayout {
            spacing: Theme.space-1;
            Text {
                text: title;
                color: Theme.fg;
                font-family: Theme.font-body;
                font-size: Theme.text-base;
                font-weight: Theme.font-weight-semibold;
                line-height-factor: Theme.leading-body;
            }
            Text {
                text: artist;
                color: Theme.muted;
                font-family: Theme.font-body;
                font-size: Theme.text-sm;
                line-height-factor: Theme.leading-body;
            }
            Text {
                text: state;
                color: Theme.muted;
                font-family: Theme.font-body;
                font-size: Theme.text-xs;
                line-height-factor: Theme.leading-body;
            }
        }
    }
}
