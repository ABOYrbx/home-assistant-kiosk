import { Theme } from "../theme.slint";
import { KioskModel } from "../model.slint";

export component TopBar inherits Rectangle {
    in property <bool> compact: false;

    height: root.compact ? Theme.topbar-height-compact : Theme.topbar-height;
    background: Theme.bg;

    Rectangle {
        x: (parent.width - self.width) / 2;
        width: min(parent.width, Theme.content-max-width);
        height: parent.height;

        HorizontalLayout {
            padding-left: root.compact ? Theme.space-3 : Theme.space-6;
            padding-right: root.compact ? Theme.space-3 : Theme.space-6;
            spacing: Theme.space-3;
            alignment: space-between;

            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: start;

                Rectangle {
                    width: Theme.status-dot-size;
                    height: Theme.status-dot-size;
                    border-radius: Theme.radius-pill;
                    background: Theme.accent;
                }

                brand := Text {
                    text: KioskModel.brand-title;
                    color: Theme.fg;
                    font-family: Theme.font-body;
                    font-size: root.compact ? Theme.text-base : Theme.text-lg;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                spacing: root.compact ? Theme.space-3 : Theme.space-5;
                alignment: end;

                Rectangle {
                    height: Theme.connection-pill-height;
                    border-radius: Theme.radius-pill;
                    border-width: Theme.border-width;
                    border-color: Theme.border;
                    background: Theme.surface;

                    HorizontalLayout {
                        padding-left: Theme.space-3;
                        padding-right: Theme.space-3;
                        spacing: Theme.space-2;
                        alignment: center;

                        Rectangle {
                            width: Theme.status-dot-size;
                            height: Theme.status-dot-size;
                            border-radius: Theme.radius-pill;
                            background: KioskModel.connection-connected
                                ? Theme.success
                                : KioskModel.connection-error
                                    ? Theme.danger
                                    : Theme.warn;
                        }

                        connection-label := Text {
                            text: KioskModel.connection-label;
                            color: Theme.fg-2;
                            font-family: Theme.font-body;
                            font-size: Theme.text-sm;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                VerticalLayout {
                    width: Theme.clock-width;
                    spacing: 0px;
                    alignment: center;

                    clock-text := Text {
                        text: KioskModel.clock-text;
                        color: Theme.fg;
                        font-family: Theme.font-mono;
                        font-size: root.compact ? Theme.text-lg : Theme.text-xl;
                        font-weight: Theme.weight-semibold;
                        horizontal-alignment: right;
                        overflow: elide;
                    }

                    date-text := Text {
                        text: KioskModel.date-text;
                        color: Theme.muted;
                        font-family: Theme.font-body;
                        font-size: Theme.text-xs;
                        horizontal-alignment: right;
                        overflow: elide;
                    }
                }
            }
        }
    }

    Rectangle {
        y: parent.height - Theme.border-width;
        width: parent.width;
        height: Theme.border-width;
        background: Theme.border;
    }
}
