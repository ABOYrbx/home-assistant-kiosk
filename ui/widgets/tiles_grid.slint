import { Theme } from "../theme.slint";
import { HaTile } from "ha_tile.slint";

export struct TileItem {
    entity-id: string,
    label: string,
    icon: string,
    state: string,
    detail: string,
    read-only: bool,
    pending: bool,
    error: string,
    row: int,
    col: int,
}

export component TilesGrid inherits Rectangle {
    in property <[TileItem]> tiles: [];
    callback tapped(string);

    background: transparent;

    GridLayout {
        spacing: Theme.space-2;
        for tile in root.tiles : HaTile {
            row: tile.row;
            col: tile.col;
            label: tile.label;
            icon: tile.icon;
            state: tile.state;
            detail: tile.detail;
            read-only: tile.read-only;
            pending: tile.pending;
            error: tile.error;
            tapped => { root.tapped(tile.entity-id); }
        }
    }
}
