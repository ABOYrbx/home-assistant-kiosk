import { Theme } from "../theme.slint";

export component WeatherWidget inherits Rectangle {
    in property <string> condition: "";
    in property <string> temperature: "";

    background: Theme.surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-1;
        Text { text: "Weather"; color: Theme.muted; font-size: Theme.text-xs; }
        Text { text: temperature; color: Theme.fg; font-size: Theme.text-xl; font-weight: 600; }
        Text { text: condition; color: Theme.fg-2; font-size: Theme.text-sm; }
    }
}