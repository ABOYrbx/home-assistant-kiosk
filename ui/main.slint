import { Theme } from "theme.slint";
import { OverviewPage } from "pages/overview.slint";
import { MediaPage } from "pages/media.slint";
import { AgendaPage } from "pages/agenda.slint";
import { StatusPage } from "pages/status.slint";
import { ShopPage, ShopEntryView } from "pages/shop.slint";
import { TileItem } from "widgets/tiles_grid.slint";

export component TabButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked();

    min-width: Theme.touch-target;
    min-height: Theme.touch-target;
    border-radius: Theme.radius-md;
    background: active ? Theme.accent : Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    Text {
        text: label;
        color: active ? Theme.accent-on : Theme.fg;
        font-size: Theme.text-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    states [
        pressed when ta.pressed: {
            background: Theme.border;
        }
    ]
}

export component MainWindow inherits Window {
    title: "Home Assistant Kiosk";
    min-width: 320px;
    min-height: 240px;

    in-out property <int> current-page: 0;
    in-out property <[TileItem]> tiles: [];
    in-out property <int> tile-columns: 1;
    // The Shop is a fifth page that only exists when extensions are enabled.
    in property <bool> extensions-enabled: false;
    in property <[ShopEntryView]> shop-installed: [];
    in property <[ShopEntryView]> shop-available: [];
    in property <bool> shop-catalog-online: true;
    in property <string> shop-catalog-error: "";
    in property <string> shop-config-path: "";
    in property <string> shop-secret-dir: "";
    in property <string> shop-pending-id: "";
    in property <[string]> extension-errors: [];
    callback page-changed(int);
    callback tile-tapped(string);
    callback swipe-next();
    callback swipe-prev();
    callback shop-refresh();
    callback shop-install(string);
    callback shop-update(string);
    callback shop-remove(string);
    callback shop-set-enabled(string, bool);

    // Swipe tracking
    property <length> swipe-start-x: 0px;
    property <length> swipe-start-y: 0px;
    property <bool> swipe-tracking: false;

    VerticalLayout {
        spacing: 0px;

        // Tab bar
        Rectangle {
            height: Theme.touch-target + Theme.space-2;
            background: Theme.surface;
            border-width: 0px;
            border-color: Theme.border;

            HorizontalLayout {
                padding: Theme.space-2;
                spacing: Theme.space-2;
                alignment: start;

                tab-overview := TabButton {
                    label: "Overview";
                    active: current-page == 0;
                    clicked => { current-page = 0; page-changed(0); }
                }
                tab-media := TabButton {
                    label: "Media";
                    active: current-page == 1;
                    clicked => { current-page = 1; page-changed(1); }
                }
                tab-agenda := TabButton {
                    label: "Agenda";
                    active: current-page == 2;
                    clicked => { current-page = 2; page-changed(2); }
                }
                tab-status := TabButton {
                    label: "Status";
                    active: current-page == 3;
                    clicked => { current-page = 3; page-changed(3); }
                }
                if extensions-enabled : tab-shop := TabButton {
                    label: "Shop";
                    active: current-page == 4;
                    clicked => { current-page = 4; page-changed(4); }
                }
            }
        }

        // Page host with swipe TouchArea behind content
        Rectangle {
            background: Theme.bg;
            vertical-stretch: 1;

            swipe-area := TouchArea {
                width: 100%;
                height: 100%;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        swipe-start-x = self.mouse-x;
                        swipe-start-y = self.mouse-y;
                        swipe-tracking = true;
                    }
                    if (event.kind == PointerEventKind.up && swipe-tracking) {
                        let dx = self.mouse-x - swipe-start-x;
                        let dy = self.mouse-y - swipe-start-y;
                        swipe-tracking = false;
                        if ((abs(dx) >= 60px) || (abs(dx) >= self.width / 5)) && abs(dx) > abs(dy) {
                            if (dx < 0px) { swipe-next(); }
                            else { swipe-prev(); }
                        }
                    }
                    if (event.kind == PointerEventKind.cancel) {
                        swipe-tracking = false;
                    }
                }
            }

            if current-page == 0 : OverviewPage {
                x: 0px; y: 0px; width: 100%; height: 100%;
                tiles: root.tiles;
                tile-columns: root.tile-columns;
                tile-tapped(entity-id) => { root.tile-tapped(entity-id); }
            }
            if current-page == 1 : MediaPage { x: 0px; y: 0px; width: 100%; height: 100%; }
            if current-page == 2 : AgendaPage { x: 0px; y: 0px; width: 100%; height: 100%; }
            if current-page == 3 : StatusPage {
                x: 0px; y: 0px; width: 100%; height: 100%;
                extension-errors: root.extension-errors;
            }
            if current-page == 4 && extensions-enabled : ShopPage {
                x: 0px; y: 0px; width: 100%; height: 100%;
                installed: root.shop-installed;
                available: root.shop-available;
                catalog-online: root.shop-catalog-online;
                catalog-error: root.shop-catalog-error;
                config-path: root.shop-config-path;
                secret-dir: root.shop-secret-dir;
                pending-id: root.shop-pending-id;
                refresh() => { root.shop-refresh(); }
                confirm-install(id) => { root.shop-install(id); }
                update(id) => { root.shop-update(id); }
                remove(id) => { root.shop-remove(id); }
                set-enabled(id, on) => { root.shop-set-enabled(id, on); }
            }
        }
    }
}
