import { Theme } from "theme.slint";
export { Theme } from "theme.slint";
import { SwipeArea } from "components/swipe_area.slint";
import { OverviewPage } from "pages/overview.slint";
import { MediaPage } from "pages/media.slint";
import { AgendaPage } from "pages/agenda.slint";
import { StatusPage } from "pages/status.slint";

// A 44 x 44 touch target with a pressed state and a keyboard focus ring.
// Focus rings are useful in desktop development builds; touch use never needs
// them, but they cost nothing on the kiosk.
component TabButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked();

    min-width: Theme.touch-target;
    height: Theme.touch-target;
    horizontal-stretch: 1;
    border-radius: Theme.radius-md;
    background: ta.pressed ? Theme.accent-active : (root.active ? Theme.accent : Theme.surface);
    border-width: focus-scope.has-focus ? Theme.focus-ring-width : Theme.border-width;
    border-color: focus-scope.has-focus ? Theme.focus-ring : Theme.border;

    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }

    Text {
        text: root.label;
        color: root.active ? Theme.accent-on : Theme.fg;
        font-family: Theme.font-body;
        font-size: Theme.text-sm;
        font-weight: root.active ? Theme.weight-semibold : Theme.weight-medium;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    focus-scope := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            focus-scope.focus();
            root.clicked();
        }
    }
}

export component MainWindow inherits Window {
    title: "Home Assistant Kiosk";
    min-width: Theme.window-min-width;
    min-height: Theme.window-min-height;
    background: Theme.bg;

    in-out property <int> page-count: 4;
    // The threshold belongs to the page, not to the 16px edge zone that hosts
    // the gesture, so every swipe area receives the same value.
    property <length> page-swipe-threshold: max(Theme.swipe-threshold, root.width * Theme.swipe-threshold-fraction);

    in-out property <int> current-page: 0;
    in-out property <string> connection-text: "Disconnected";
    in-out property <bool> connected: false;
    in-out property <bool> stale: true;
    in-out property <string> ha-version: "";
    in-out property <string> clock-text: "--:--";
    in-out property <string> date-text: "";
    in-out property <bool> overview-tile-selected: false;
    in-out property <float> media-slider-value: 50;
    in-out property <length> agenda-scroll-y: 0px;

    callback page-changed(int);

    VerticalLayout {
        spacing: 0px;

        // Fixed top bar: shell status only, no data widgets.
        top-bar := Rectangle {
            height: Theme.touch-target;
            background: Theme.surface;
            border-width: Theme.border-width;
            border-color: Theme.border;

            HorizontalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-3;
                spacing: Theme.space-3;

                top-bar-title := Text {
                    text: "Home Assistant Kiosk";
                    horizontal-stretch: 1;
                    color: Theme.fg;
                    font-family: Theme.font-body;
                    font-size: Theme.text-base;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle {
                    width: 112px;
                    height: 28px;
                    border-radius: Theme.radius-pill;
                    background: Theme.surface-warm;
                    border-width: Theme.border-width;
                    border-color: Theme.border;

                    HorizontalLayout {
                        padding-left: Theme.space-2;
                        padding-right: Theme.space-2;
                        spacing: Theme.space-2;
                        alignment: center;

                        connection-dot := Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: Theme.radius-pill;
                            background: root.connected
                                ? Theme.success
                                : (root.stale ? Theme.warn : Theme.muted);
                        }

                        Text {
                            text: root.connection-text;
                            color: Theme.fg-2;
                            font-family: Theme.font-body;
                            font-size: Theme.text-xs;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }

                Text {
                    text: root.clock-text;
                    color: Theme.fg;
                    font-family: Theme.font-mono;
                    font-size: Theme.text-sm;
                    vertical-alignment: center;
                }
            }
        }

        // Tab bar: the reliable navigation fallback for every page.
        tab-bar := Rectangle {
            height: Theme.touch-target + Theme.space-4;
            background: Theme.bg;
            border-width: Theme.border-width;
            border-color: Theme.border;

            HorizontalLayout {
                padding: Theme.space-2;
                spacing: Theme.space-2;

                tab-overview := TabButton {
                    label: "Overview";
                    active: root.current-page == 0;
                    clicked => {
                        root.current-page = 0;
                        root.page-changed(0);
                    }
                }
                tab-media := TabButton {
                    label: "Media";
                    active: root.current-page == 1;
                    clicked => {
                        root.current-page = 1;
                        root.page-changed(1);
                    }
                }
                tab-agenda := TabButton {
                    label: "Agenda";
                    active: root.current-page == 2;
                    clicked => {
                        root.current-page = 2;
                        root.page-changed(2);
                    }
                }
                tab-status := TabButton {
                    label: "Status";
                    active: root.current-page == 3;
                    clicked => {
                        root.current-page = 3;
                        root.page-changed(3);
                    }
                }
            }
        }

        // Page host. The background swipe area is declared first so page
        // content (Flickables, sliders, tiles, buttons) wins the hit test.
        page-host := Rectangle {
            vertical-stretch: 1;
            background: Theme.bg;
            clip: true;

            background-swipe := SwipeArea {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                threshold: root.page-swipe-threshold;
                threshold-fraction: 0.0;

                swiped(direction) => {
                    if (direction < 0) {
                        root.current-page = Math.mod(root.current-page + 1, root.page-count);
                    } else {
                        root.current-page = Math.mod(root.current-page + root.page-count - 1, root.page-count);
                    }
                    root.page-changed(root.current-page);
                }
            }

            if root.current-page == 0 : OverviewPage {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                tile-selected: root.overview-tile-selected;
                tile-activated => { root.overview-tile-selected = !root.overview-tile-selected; }
            }

            if root.current-page == 1 : MediaPage {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                slider-value: root.media-slider-value;
                slider-changed(value) => { root.media-slider-value = value; }
            }

            if root.current-page == 2 : AgendaPage {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                scroll-y: root.agenda-scroll-y;
                scroll-changed(value) => { root.agenda-scroll-y = value; }
            }

            if root.current-page == 3 : StatusPage {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
            }

            // Non-interactive edge gutters over the 16px page padding. These
            // are the only swipe zones above page content.
            edge-swipe-left := SwipeArea {
                x: 0px;
                y: 0px;
                width: Theme.space-4;
                height: 100%;
                threshold: root.page-swipe-threshold;
                threshold-fraction: 0.0;

                swiped(direction) => {
                    if (direction < 0) {
                        root.current-page = Math.mod(root.current-page + 1, root.page-count);
                    } else {
                        root.current-page = Math.mod(root.current-page + root.page-count - 1, root.page-count);
                    }
                    root.page-changed(root.current-page);
                }
            }

            edge-swipe-right := SwipeArea {
                x: parent.width - Theme.space-4;
                y: 0px;
                width: Theme.space-4;
                height: 100%;
                threshold: root.page-swipe-threshold;
                threshold-fraction: 0.0;

                swiped(direction) => {
                    if (direction < 0) {
                        root.current-page = Math.mod(root.current-page + 1, root.page-count);
                    } else {
                        root.current-page = Math.mod(root.current-page + root.page-count - 1, root.page-count);
                    }
                    root.page-changed(root.current-page);
                }
            }
        }
    }
}
