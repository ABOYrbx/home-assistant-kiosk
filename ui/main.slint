import { Theme } from "theme.slint";
import { SwipeArea } from "widgets/swipe_area.slint";
import { OverviewPage } from "pages/overview.slint";
import { MediaPage } from "pages/media.slint";
import { AgendaPage } from "pages/agenda.slint";
import { StatusPage } from "pages/status.slint";

export component TabButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked();

    min-width: Theme.touch-target;
    min-height: Theme.touch-target;
    border-radius: Theme.radius-md;
    background: active ? Theme.accent : Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    Text {
        text: label;
        color: active ? Theme.accent-on : Theme.fg;
        font-size: Theme.text-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    states [
        pressed when ta.pressed: {
            background: Theme.border;
        }
    ]
}

export component MainWindow inherits Window {
    title: "Home Assistant Kiosk";
    min-width: 320px;
    min-height: 240px;

    in-out property <int> current-page: 0;
    callback page-changed(int);
    callback swipe-next();
    callback swipe-prev();

    // Reserved width of the edge swipe zones. Pages are inset by this amount
    // so the edge zones only ever sit on page background, never on a control.
    private property <length> edge-zone-width: Theme.space-4;

    VerticalLayout {
        spacing: 0px;

        // Tab bar
        Rectangle {
            height: Theme.touch-target + Theme.space-2;
            background: Theme.surface;
            border-width: 0px;
            border-color: Theme.border;

            HorizontalLayout {
                padding: Theme.space-2;
                spacing: Theme.space-2;
                alignment: start;

                tab-overview := TabButton {
                    label: "Overview";
                    active: current-page == 0;
                    clicked => { current-page = 0; page-changed(0); }
                }
                tab-media := TabButton {
                    label: "Media";
                    active: current-page == 1;
                    clicked => { current-page = 1; page-changed(1); }
                }
                tab-agenda := TabButton {
                    label: "Agenda";
                    active: current-page == 2;
                    clicked => { current-page = 2; page-changed(2); }
                }
                tab-status := TabButton {
                    label: "Status";
                    active: current-page == 3;
                    clicked => { current-page = 3; page-changed(3); }
                }
            }
        }

        // Page host. A page swipe may only start on non-interactive background
        // or in the reserved edge zones, never on a control inside a page.
        Rectangle {
            background: Theme.bg;
            vertical-stretch: 1;
            clip: true;

            // Background swipe layer, behind every page. An interactive widget
            // is above this layer and receives the press itself, so a slider,
            // scrollable list, button, or tile can never start a page swipe.
            swipe-area := SwipeArea {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                page-width: parent.width;
                swipe-next => { root.swipe-next(); }
                swipe-prev => { root.swipe-prev(); }
            }

            // Pages are inset by the edge-zone width; see the edge zones below.
            if current-page == 0 : OverviewPage {
                x: edge-zone-width;
                y: 0px;
                width: parent.width - 2 * edge-zone-width;
                height: 100%;
            }
            if current-page == 1 : MediaPage {
                x: edge-zone-width;
                y: 0px;
                width: parent.width - 2 * edge-zone-width;
                height: 100%;
            }
            if current-page == 2 : AgendaPage {
                x: edge-zone-width;
                y: 0px;
                width: parent.width - 2 * edge-zone-width;
                height: 100%;
            }
            if current-page == 3 : StatusPage {
                x: edge-zone-width;
                y: 0px;
                width: parent.width - 2 * edge-zone-width;
                height: 100%;
            }

            // Edge zones: a reliable swipe target at the screen border. They
            // are above the page on purpose, but the page inset above keeps
            // them clear of every control.
            edge-swipe-left := SwipeArea {
                x: 0px;
                y: 0px;
                width: edge-zone-width;
                height: 100%;
                page-width: parent.width;
                swipe-next => { root.swipe-next(); }
                swipe-prev => { root.swipe-prev(); }
            }
            edge-swipe-right := SwipeArea {
                x: parent.width - edge-zone-width;
                y: 0px;
                width: edge-zone-width;
                height: 100%;
                page-width: parent.width;
                swipe-next => { root.swipe-next(); }
                swipe-prev => { root.swipe-prev(); }
            }
        }
    }
}
