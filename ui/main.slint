import { Theme } from "theme.slint";
import { OverviewPage } from "pages/overview.slint";
import { MediaPage } from "pages/media.slint";
import { AgendaPage } from "pages/agenda.slint";
import { StatusPage } from "pages/status.slint";

export component TabButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked();

    out property <bool> pressed: ta.pressed;
    out property <bool> has-focus: focus-scope.has-focus;

    min-width: Theme.touch-target;
    min-height: Theme.touch-target;
    border-radius: Theme.radius-md;
    background: active ? Theme.accent : Theme.surface;
    border-width: 1px;
    border-color: active ? Theme.accent : Theme.border;

    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selectable: true;
    accessible-item-selected: root.active;
    accessible-action-default => { root.clicked(); }

    // Pressed feedback sits between the background and the label so the fill
    // darkens without changing the selected/active colour.
    pressed-fill := Rectangle {
        visible: ta.pressed;
        background: active ? Theme.accent-active : Theme.border;
        border-radius: root.border-radius;
    }

    Text {
        text: label;
        color: active ? Theme.accent-on : Theme.fg;
        font-size: Theme.text-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Keyboard focus ring. Mouse clicks do not take focus, so the ring only
    // appears for keyboard navigation in desktop development builds.
    focus-outline := Rectangle {
        visible: focus-scope.has-focus;
        border-width: 2px;
        border-color: active ? Theme.accent-on : Theme.accent;
        border-radius: root.border-radius;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    focus-scope := FocusScope {
        x: 0px;
        width: 0px;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    forward-focus: focus-scope;
}

export component MainWindow inherits Window {
    title: "Home Assistant Kiosk";
    min-width: 320px;
    min-height: 240px;

    in-out property <int> current-page: 0;
    callback page-changed(int);
    callback swipe-next();
    callback swipe-prev();

    // Interaction state for the shell tests and for keyboard navigation.
    out property <int> focused-tab:
        tab-overview.has-focus ? 0
        : tab-media.has-focus ? 1
        : tab-agenda.has-focus ? 2
        : tab-status.has-focus ? 3
        : -1;
    out property <bool> tab-pressed:
        tab-overview.pressed
        || tab-media.pressed
        || tab-agenda.pressed
        || tab-status.pressed;

    // Swipe tracking
    property <length> swipe-start-x: 0px;
    property <length> swipe-start-y: 0px;
    property <bool> swipe-tracking: false;

    VerticalLayout {
        spacing: 0px;

        // Tab bar
        Rectangle {
            height: Theme.touch-target + Theme.space-2;
            background: Theme.surface;
            border-width: 0px;
            border-color: Theme.border;

            HorizontalLayout {
                padding: Theme.space-2;
                spacing: Theme.space-2;
                alignment: start;

                tab-overview := TabButton {
                    label: "Overview";
                    active: current-page == 0;
                    clicked => { current-page = 0; page-changed(0); }
                }
                tab-media := TabButton {
                    label: "Media";
                    active: current-page == 1;
                    clicked => { current-page = 1; page-changed(1); }
                }
                tab-agenda := TabButton {
                    label: "Agenda";
                    active: current-page == 2;
                    clicked => { current-page = 2; page-changed(2); }
                }
                tab-status := TabButton {
                    label: "Status";
                    active: current-page == 3;
                    clicked => { current-page = 3; page-changed(3); }
                }
            }
        }

        // Page host with swipe TouchArea behind content
        Rectangle {
            background: Theme.bg;
            vertical-stretch: 1;

            swipe-area := TouchArea {
                width: 100%;
                height: 100%;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        swipe-start-x = self.mouse-x;
                        swipe-start-y = self.mouse-y;
                        swipe-tracking = true;
                    }
                    if (event.kind == PointerEventKind.up && swipe-tracking) {
                        let dx = self.mouse-x - swipe-start-x;
                        let dy = self.mouse-y - swipe-start-y;
                        swipe-tracking = false;
                        if ((abs(dx) >= 60px) || (abs(dx) >= self.width / 5)) && abs(dx) > abs(dy) {
                            if (dx < 0px) { swipe-next(); }
                            else { swipe-prev(); }
                        }
                    }
                    if (event.kind == PointerEventKind.cancel) {
                        swipe-tracking = false;
                    }
                }
            }

            if current-page == 0 : OverviewPage { x: 0px; y: 0px; width: 100%; height: 100%; }
            if current-page == 1 : MediaPage { x: 0px; y: 0px; width: 100%; height: 100%; }
            if current-page == 2 : AgendaPage { x: 0px; y: 0px; width: 100%; height: 100%; }
            if current-page == 3 : StatusPage { x: 0px; y: 0px; width: 100%; height: 100%; }
        }
    }
}
